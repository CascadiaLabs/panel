# Machine-to-machine API-токен (Bearer). Используется скриптами (dev/stack.py,
# curl). Логин в веб-интерфейсе — по паролю, этот токен для UI не нужен.
# Пустое значение отключает bearer-вход (остаётся логин по паролю).
PANEL_TOKEN=secret

# Пароль пользователя admin — применяется только при первом старте
# (пустая БД). Если не задан, генерируется случайный и печатается в лог:
#   docker logs cascadia-panel 2>&1 | grep 'FIRST LOGIN'
# После первого входа пароль меняется в веб-интерфейсе.
PANEL_ADMIN_PASSWORD=

# Путь к SQLite-БД (в контейнере лежит на volume).
DB_PATH=/data/panel.db

# Адрес веб-интерфейса и API.
LISTEN_ADDR=0.0.0.0:2083
